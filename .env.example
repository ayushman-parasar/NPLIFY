# --- Claude API -------------------------------------------------------------
ANTHROPIC_API_KEY=
# Model that answers in the assistant. Default is Opus 5.5; set claude-sonnet-5-5 for lower cost.
ANTHROPIC_MODEL=claude-opus-5-5
# Thinking effort for chat answers: low | medium | high
ANTHROPIC_EFFORT=medium

# --- Database (Neon Postgres, free tier is enough) ---------------------------
DATABASE_URL=

# --- Auth.js (magic-link sign-in) --------------------------------------------
# openssl rand -base64 32
AUTH_SECRET=
# Resend API key and verified sender address
AUTH_RESEND_KEY=
AUTH_EMAIL_FROM="NPLify ERD <erd@yourdomain.com>"
# Comma-separated allowlist. Either exact addresses or whole domains (@npl.example).
ALLOWED_EMAILS=
# Comma-separated admin addresses: can open /admin (conversation log, flags)
ADMIN_EMAILS=

# --- Features -----------------------------------------------------------------
# Let signed-in users flag an entity with a comment. Set to false before launch to disable.
NEXT_PUBLIC_FLAGGING_ENABLED=true
# Questions per user per 24h
ASK_DAILY_LIMIT=200
# Local development only: skips sign-in and database writes when DATABASE_URL is empty.
# Ignored in production builds.
AUTH_DISABLED=false
